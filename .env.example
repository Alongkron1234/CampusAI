# ===== Generation (เรียก Gemini API เฉพาะตอนตอบคำถาม/eval) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ===== OCR: Typhoon OCR ผ่าน Ollama (OpenAI-compatible endpoint, รันบนเครื่อง) =====
OLLAMA_BASE_URL=http://localhost:11434/v1
OCR_MODEL=scb10x/typhoon-ocr1.5-3b

# ===== Embedding (รันบนเครื่อง) =====
EMBED_MODEL=BAAI/bge-m3

# ===== Vector DB: Qdrant — เลือกโหมดได้ =====
# local: เก็บเป็นไฟล์บนเครื่องที่ QDRANT_PATH (ค่าเริ่มต้น ไม่ต้องตั้งค่าเพิ่ม)
# cloud: ใช้ Qdrant Cloud ต้องตั้ง QDRANT_URL และ QDRANT_API_KEY
QDRANT_MODE=local
QDRANT_PATH=data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
