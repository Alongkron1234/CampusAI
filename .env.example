# ===== Gemini API (ใช้ตอนตอบคำถาม/eval เสมอ และใช้ตอน OCR ด้วยถ้า OCR_BACKEND=gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# รุ่นสำรองตอนรุ่นหลักล่ม (429/503) จน retry หมด เว้นว่างได้
GEMINI_FALLBACK_MODEL=

# ===== LLM ที่ใช้ตอบคำถาม — เลือก backend ได้ =====
# gemini (ค่าเริ่มต้น): คุณภาพดีกว่า แต่ free tier ได้ ~20 ครั้ง/วัน/รุ่น
# ollama: รันบนเครื่อง ไม่มีโควตา แต่ตอบภาษาไทย/อ้างอิงได้แย่กว่าและช้ากว่า
#         ต้อง `ollama pull <OLLAMA_LLM_MODEL>` ก่อน
LLM_BACKEND=gemini
OLLAMA_LLM_MODEL=qwen3:4b

# ===== OCR — เลือก backend ได้ =====
# typhoon (ค่าเริ่มต้น): รันบนเครื่องผ่าน Ollama ฟรี ไม่มี limit แต่ช้ากว่า (~30-90s/หน้า)
# gemini: เร็วกว่ามาก (มักไม่ถึง 10s/หน้า) แต่มี free tier จำกัด/วัน และข้อมูลออกจากเครื่อง
#         ต้องตั้ง GEMINI_API_KEY ด้านบนด้วย
OCR_BACKEND=typhoon
OLLAMA_BASE_URL=http://localhost:11434/v1
OCR_MODEL=scb10x/typhoon-ocr1.5-3b

# ===== Embedding (รันบนเครื่อง) =====
EMBED_MODEL=BAAI/bge-m3

# ===== Vector DB: Qdrant — เลือกโหมดได้ =====
# local: เก็บเป็นไฟล์บนเครื่องที่ QDRANT_PATH (ค่าเริ่มต้น ไม่ต้องตั้งค่าเพิ่ม)
# cloud: ใช้ Qdrant Cloud ต้องตั้ง QDRANT_URL และ QDRANT_API_KEY
QDRANT_MODE=local
QDRANT_PATH=data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
